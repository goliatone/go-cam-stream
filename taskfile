#!/bin/bash

# Check for -debug flag
if [[ $* == *-debug* ]]; then
    set -x
fi

export LGR_NO_TIMESTAMP=true

GIT_MAIN="main"

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION_FILE="${SCRIPT_DIR}/.version"

# If we have a .taskenv file load it as source
# the file should be e.g.
# #!/bin/bash
# export DATABASE_URL="..."
if [ -f .taskenv ]; then
    # shellcheck disable=SC1091
    source .taskenv
fi

# This makes all bin packages installed via npm available here
# e.g. bogota, nyc, autocannon, etc.
PATH=$(pwd)/node_modules/.bin:$PATH

# This will make all scripts available in the ./src/bin directory
PATH=$(pwd)/src/bin:$PATH


#################################################
# Development dependencies
#################################################

function _install:lgr {
    mkdir -p bin
    if hash lgr 2>/dev/null; then
        lgr OK "lgr already installed..."
    else
        if [[ $(command -v brew) == "" ]]; then
            echo "Installing lgr"
            brew tap goliatone/homebrew-tap
            brew install lgr
            lgr OK "lgr installed..."
        else
            LGR_VERSION="0.1.1"
            LGR_FILENAME="lgr_${LGR_VERSION}_linux_x86_64.tar.gz"
            curl -sL "https://github.com/goliatone/lgr/releases/download/v${LGR_VERSION}/${LGR_FILENAME}" | tar xz
            chmod +x lgr
            lgr OK "lgr installed"
        fi
    fi
}

function _install:changelog {
    if git-cliff lgr 2>/dev/null; then
        lgr OK "git-cliff already installed..."
    else
        echo "Installing lgr"
        brew install brew install orhun/git-cliff/git-cliff
        lgr OK "git-cliff installed..."
    fi
}

function _install:brew {
    if [[ $(command -v brew) == "" ]]; then
        lgr I "Installing Hombrew"
        /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    else
        lgr I "Updating Homebrew"
        brew update
    fi
}

function _install:envset {
    if hash envset 2>/dev/null; then
        lgr OK "envset installed..."
    else
        lgr I "Installing envset..."
        brew install envset
        lgr OK "envset installed..."
    fi
}

function lgr {
  if command -v lgr >/dev/null 2>&1; then
    command lgr "$@"
  else
    printf '%s\n' "$*"
  fi
}

##########################################
# Application management
##########################################

function dev:install {
    cd "$(pwd)/src" || exit "$?"

    _install:lgr
    _install:brew

    _install:envset
    _install:changelog

    lgr ok "dependencies intalled..."
}

function dev:env:load {
    eval "$(envset development --isolated=true)"
}

## dev:build
## Install locked frontend dependencies, build/embed assets, and compile normal/dev binaries.
function dev:build() (
    cd "${SCRIPT_DIR}" || exit "$?"
    local tool
    for tool in go node npm; do
        if ! command -v "${tool}" >/dev/null 2>&1; then
            echo "dev:build requires ${tool} on PATH." >&2
            return 1
        fi
    done

    ./scripts/build-web.sh || return "$?"
    mkdir -p bin || return "$?"
    go build -o bin/camstream ./cmd/camstream || return "$?"
    go build -tags camstream_dev -o bin/camstream-dev ./cmd/camstream-dev
)

## dev:webcams
## List Mac webcams and their indices for dev:serve --webcam=INDEX, without capture.
function dev:webcams {
    case "${1:-}" in
        -h|--help) echo "Usage: $0 dev:webcams (uses CAMSTREAM_DEV_FFMPEG or ffmpeg on PATH)"; return 0 ;;
        "") ;;
        *) echo "Unknown dev:webcams argument: $1" >&2; return 2 ;;
    esac
    if [ "$(uname -s)" != Darwin ]; then
        echo "dev:webcams requires macOS (AVFoundation)." >&2
        return 2
    fi
    local ffmpeg listing devices
    ffmpeg=$(command -v "${CAMSTREAM_DEV_FFMPEG:-ffmpeg}") || {
        echo "Install FFmpeg (brew install ffmpeg) or set CAMSTREAM_DEV_FFMPEG to its executable." >&2
        return 1
    }
    # FFmpeg exits nonzero after a successful enumeration because no input is opened.
    listing=$("${ffmpeg}" -hide_banner -nostdin -f avfoundation -list_devices true -i "" 2>&1) || :
    if [[ "${listing}" != *"AVFoundation video devices:"* || "${listing}" != *"AVFoundation audio devices:"* ]]; then
        printf 'Unable to list webcams with FFmpeg.\n%s\n' "${listing}" >&2
        return 1
    fi
    devices=$(printf '%s\n' "${listing}" | awk '
        /AVFoundation video devices:/ { video = 1; next }
        /AVFoundation audio devices:/ { video = 0 }
        video && /\] \[[0-9]+\] / {
            sub(/^[^]]*\] \[/, "")
            indexEnd = index($0, "] ")
            deviceIndex = substr($0, 1, indexEnd - 1)
            name = substr($0, indexEnd + 2)
            if (name !~ /^Capture screen [0-9]+$/) printf "  %s\t%s\n", deviceIndex, name
        }
    ')
    if [ -z "${devices}" ]; then
        echo "No webcams found. Connect a camera and check Camera access for your terminal/app."
        return 0
    fi
    printf 'INDEX\tWEBCAM\n%s\n\nUse: ./taskfile dev:serve --webcam=INDEX\n' "${devices}"
}

## dev:serve [PORT | --port PORT] [--config FILE] [--webcam[=INDEX]] [--media-address IPv4]
## Build and serve with config/dev.yaml; override with --config or CAMSTREAM_CONFIG.
## Re-run after source changes. Ctrl-C gracefully stops the server.
function dev:serve {
    local config="${CAMSTREAM_CONFIG:-${SCRIPT_DIR}/config/dev.yaml}"
    local webcam=""
    local port="" port_set=false
    local media_address="" media_set=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --port)
                if [ "$#" -lt 2 ]; then
                    echo "--port requires a port between 1 and 65535." >&2
                    return 2
                fi
                if [ "${port_set}" = true ]; then
                    echo "Specify the development port only once." >&2
                    return 2
                fi
                port="$2"; port_set=true; shift 2
                ;;
            --port=*|[0-9]*)
                if [ "${port_set}" = true ]; then
                    echo "Specify the development port only once." >&2
                    return 2
                fi
                port="${1#--port=}"; port_set=true; shift
                ;;
            --media-address|--media-address=*)
                if [ "${media_set}" = true ]; then
                    echo "Specify --media-address only once." >&2; return 2
                fi
                media_set=true
                if [ "$1" = --media-address ]; then
                    if [ "$#" -lt 2 ]; then echo "--media-address requires this Mac's private IPv4 address." >&2; return 2; fi
                    media_address="$2"; shift 2
                else
                    media_address="${1#*=}"; shift
                fi
                if ! [[ "${media_address}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
                    echo "--media-address requires this Mac's private IPv4 address." >&2; return 2
                fi
                ;;
            --config)
                if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                    echo "--config requires a file path." >&2
                    return 2
                fi
                config="$2"
                shift 2
                ;;
            --config=*) config="${1#*=}"; shift ;;
            --webcam) webcam=0; shift ;;
            --webcam=*)
                webcam="${1#*=}"
                if ! [[ "${webcam}" =~ ^[0-9]{1,5}$ ]] || (( 10#${webcam} > 65535 )); then
                    echo "--webcam requires a video device index between 0 and 65535 (for example --webcam=0)." >&2
                    return 2
                fi
                shift
                ;;
            -h|--help)
                echo "Usage: $0 dev:serve [PORT | --port PORT] [--config FILE] [--webcam[=INDEX]] [--media-address IPv4]"
                echo "Default: config/dev.yaml; override with CAMSTREAM_CONFIG or --config."
                echo "Port defaults to the config listen port (bundled: 8081). Example: $0 dev:serve 8087"
                echo "Mac bundled config: --webcam uses video device 0; --webcam=INDEX selects another. No audio."
                echo "List camera indices with: $0 dev:webcams"
                echo "Mac Firefox: --media-address IPv4 opts WebRTC media into one private local interface; HTTP/control stay loopback."
                return 0
                ;;
            *) echo "Unknown dev:serve argument: $1" >&2; return 2 ;;
        esac
    done
    if [ "${port_set}" = true ]; then
        if ! [[ "${port}" =~ ^[0-9]{1,5}$ ]] || (( 10#${port} < 1 || 10#${port} > 65535 )); then
            echo "Development port must be between 1 and 65535." >&2
            return 2
        fi
        port=$((10#${port}))
    fi
    if [ -z "${config}" ] || [ ! -f "${config}" ]; then
        echo "Set CAMSTREAM_CONFIG or pass --config with an existing startup YAML file." >&2
        return 2
    fi

    if [ -n "${webcam}" ] && { [ "$(uname -s)" != Darwin ] || [ ! "${config}" -ef "${SCRIPT_DIR}/config/dev.yaml" ]; }; then
        echo "--webcam requires macOS and the bundled config/dev.yaml (omit custom --config/CAMSTREAM_CONFIG)." >&2
        return 2
    fi
    if [ "${media_set}" = true ] && [ "$(uname -s)" != Darwin ]; then
        echo "--media-address is supported only by the native Mac development host." >&2; return 2
    fi
    # A previous invocation or environment cannot opt into camera capture.
    unset CAMSTREAM_DEV_SOURCE_FFMPEG CAMSTREAM_DEV_WEBCAM_DEVICE

    if [ "$(uname -s)" = Darwin ]; then
        if [ "$(go env CGO_ENABLED)" != 1 ]; then
            echo "Native Mac dev playback requires CGO_ENABLED=1 and Xcode command-line tools." >&2
            return 1
        fi
        CAMSTREAM_DEV_GO2RTC=$(python3 "${SCRIPT_DIR}/scripts/dev-runtime.py") || return "$?"
        export CAMSTREAM_DEV_GO2RTC
        # Only the bundled config opts into local video. Custom configs dial their sources.
        if [ "${config}" -ef "${SCRIPT_DIR}/config/dev.yaml" ]; then
            CAMSTREAM_DEV_SOURCE_FFMPEG=$(command -v "${CAMSTREAM_DEV_FFMPEG:-ffmpeg}") || {
                echo "Install FFmpeg (brew install ffmpeg) or set CAMSTREAM_DEV_FFMPEG to its executable." >&2
                return 1
            }
            export CAMSTREAM_DEV_SOURCE_FFMPEG
            if [ -n "${webcam}" ]; then
                export CAMSTREAM_DEV_WEBCAM_DEVICE="${webcam}"
                echo "Webcam ${webcam} selected (video only). Allow Camera access for your launching app if macOS prompts."
            fi
        fi
    fi
    dev:build || return "$?"
    if [ "${config}" -ef "${SCRIPT_DIR}/config/dev.yaml" ]; then
        # The development template gets a checkout-local absolute runtime path.
        # Keep application config loading strict and custom configs unchanged.
        node - "${SCRIPT_DIR}" "${webcam}" <<'NODE' || return "$?"
const fs = require('node:fs');
const path = require('node:path');
const root = process.argv[2];
const dir = path.join(root, '.cache/dev');
let template = fs.readFileSync(path.join(root, 'config/dev.yaml'), 'utf8');
if (process.argv[3] !== '') {
    template = template.replace('name: Development test pattern', 'name: Mac webcam ' + process.argv[3])
        .replace('name: Moving test pattern', 'name: Webcam video');
}
const config = template.replace('runtime_dir: @RUNTIME_DIR@', 'runtime_dir: ' + JSON.stringify(path.join(dir, 'runtime')));
fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
fs.writeFileSync(path.join(dir, 'config.yaml'), config, { mode: 0o600 });
NODE
        config="${SCRIPT_DIR}/.cache/dev/config.yaml"
    fi
    "${SCRIPT_DIR}/bin/camstream" config validate --config "${config}" || return "$?"
    if [ -n "${media_address}" ]; then
        echo "WebRTC media will bind ${media_address} on the configured media ports (TCP/UDP as configured). HTTP and worker control remain loopback."
    fi
    echo "Starting local development server..."
    # Replace the task runner so signals reach the server without a go-run wrapper.
    CAMSTREAM_DEV_MEDIA_ADDRESS="${media_address}" CAMSTREAM_DEV_PORT="${port}" exec "${SCRIPT_DIR}/bin/camstream-dev" serve --config "${config}"
}

##
## ########################################
##           Version Management
## ########################################

##
## -----
##
## version:upsert
##
## Save version to meta file.
## First time will create file if not present
##
## Arguments:
## @arg 1 {string} [tag=0.0.1]
function version:upsert {
    local tag=${1}

    if [ -z "$tag" ]; then
        version:get
    else
        version:set "$tag" || return 1
        version:get
    fi
}

##
## -----
##
## version:get
##
## Get version from meta file.
function version:get {
    version:check || return 1
    cat "$VERSION_FILE"
}

# Match the native app's CFBundleShortVersionString limits.
function version:validate {
    if ! [[ "${1:-}" =~ ^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$ ]]; then
        echo "Version must be MAJOR.MINOR.PATCH (up to 4/2/2 digits, no leading zeros)." >&2
        return 1
    fi
}

function version:set {
    version:validate "${1:-}" || return 1
    printf '%s\n' "$1" > "$VERSION_FILE"
}

## version:bump [major|minor|patch] [--write]
## Preview the next version; only --write updates .version.
function version:bump {
    local level=patch write_to_file=0 current major minor patch next
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --write) write_to_file=1 ;;
            patch|minor|major) level=$1 ;;
            *) echo "Invalid version option: $1" >&2; return 2 ;;
        esac
        shift
    done
    current=$(version:get) || return 1
    IFS='.' read -r major minor patch <<< "$current"
    case "$level" in
        major) major=$((major+1)); minor=0; patch=0 ;;
        minor) minor=$((minor+1)); patch=0 ;;
        patch) patch=$((patch+1)) ;;
    esac
    next="$major.$minor.$patch"
    version:validate "$next" || return 1
    if [ "$write_to_file" -eq 1 ]; then
        version:set "$next"
    else
        printf '%s\n' "$next"
    fi
}

function version:check {
    if [ ! -f "$VERSION_FILE" ]; then
        echo "Missing $VERSION_FILE; restore the reviewed release baseline before releasing." >&2
        return 1
    fi
    version:validate "$(cat "$VERSION_FILE")"
}

function version:is_greater {
    local left right index
    IFS='.' read -ra left <<< "$1"
    IFS='.' read -ra right <<< "$2"
    for index in 0 1 2; do
        (( left[index] > right[index] )) && return 0
        (( left[index] < right[index] )) && return 1
    done
    return 1
}

function release:notes:has_content {
    local file=${1}

    if [ -z "${file}" ] || [ ! -f "${file}" ]; then
        return 1
    fi

    awk 'NF { found = 1; exit } END { exit found ? 0 : 1 }' "${file}"
}

function release:notes:assert_temporary {
    local file=${1}

    if [ -z "${file}" ]; then
        return 0
    fi

    if git ls-files --error-unmatch -- "${file}" >/dev/null 2>&1; then
        echo "Release notes file is tracked; refusing to consume it as temporary notes: ${file}" >&2
        echo "Use an ignored scratch file such as .release-notes.md, or set RELEASE_NOTES_FILE to an untracked path." >&2
        return 1
    fi
}

function release:changelog:generate {
    local release_tag=${1}
    local release_notes_file=${2}
    local output=${3:-CHANGELOG.md}
    local release_notes

    if release:notes:has_content "${release_notes_file}"; then
        release:notes:assert_temporary "${release_notes_file}" || return 1
        release_notes=$(cat "${release_notes_file}") || return 1
        git cliff --tag "${release_tag}" --with-tag-message "${release_notes}" --output "$output" || return 1
        return 0
    fi

    git cliff --tag "${release_tag}" --output "$output"
}


##
## -----
##
## release
##
## Bump our current version, create a git tag
## and push to trigger our release flow.
##
## Arguments:
## @arg 1 {string} [level=patch]
##        Accepted major, minor, patch
## @flag --dry-run Validate and print the plan without writes or pushes.
function release {
    local tag
    local level
    local message
    local current_branch
    local release_tag
    local main_branch="${GIT_MAIN:-main}"
    local release_notes_file
    local release_notes_enabled
    local release_notes_required=0 release_notes_hash=""
    local dry_run=0 current_version remote_refs remote_main remote_tag latest_tag local_tags
    local changelog_temp head_before

    level=""
    message=""
    release_notes_file="${RELEASE_NOTES_FILE:-${SCRIPT_DIR}/.release-notes.md}"
    if [ -n "${RELEASE_NOTES_FILE:-}" ]; then release_notes_required=1; fi
    release_notes_enabled=1

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            patch|minor|major)
                if [ -n "${level}" ]; then
                    echo "Release level specified more than once" >&2
                    return 2
                fi
                level=$1
                shift
            ;;
            --dry-run)
                dry_run=1
                shift
            ;;
            --notes|--notes-file)
                shift
                if [ -z "${1:-}" ]; then
                    echo "--notes requires a file path" >&2
                    return 2
                fi
                release_notes_file=$1
                release_notes_required=1
                shift
            ;;
            --no-release-notes)
                release_notes_enabled=0
                shift
            ;;
            --)
                shift
                while [[ "$#" -gt 0 ]]; do
                    if [ -z "${message}" ]; then
                        message=$1
                    else
                        message="${message} $1"
                    fi
                    shift
                done
            ;;
            -*)
                echo "Invalid release option: $1" >&2
                return 2
            ;;
            *)
                if [ -z "${message}" ]; then
                    message=$1
                else
                    message="${message} $1"
                fi
                shift
            ;;
        esac
    done

    level=${level:-"patch"}

    # Explicit relative note paths belong to the caller, like other file arguments.
    if [[ "$release_notes_file" != /* ]]; then
        release_notes_file="$PWD/$release_notes_file"
    fi
    if [ "$release_notes_enabled" -eq 1 ] && [ "$release_notes_required" -eq 1 ] &&
       [ ! -f "$release_notes_file" ]; then
        echo "Release notes file does not exist: $release_notes_file" >&2
        return 1
    fi
    # Resolve paths from this checkout even when invoked from another directory.
    cd "$SCRIPT_DIR" || return 1
    current_branch=$(git symbolic-ref --short HEAD) || return 1
    if [[ "$current_branch" != "$main_branch" ]]; then
        echo "Release must run on $main_branch; current branch is $current_branch" >&2
        return 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
        echo "Working tree changes are present; review and commit them before release." >&2
        git status --short >&2
        return 1
    fi
    current_version=$(version:get) || return 1
    git ls-files --error-unmatch -- "$VERSION_FILE" >/dev/null || return 1
    command -v git-cliff >/dev/null || {
        echo "Install git-cliff before releasing (brew install git-cliff)." >&2
        return 1
    }
    if [ "$release_notes_enabled" -eq 1 ]; then
        release:notes:assert_temporary "$release_notes_file" || return 1
    else
        release_notes_file=""
    fi
    # Read remote refs even in a dry run: no fetch, merge, writes or push.
    remote_refs=$(git ls-remote origin "refs/heads/$main_branch" 'refs/tags/v*') || return 1
    remote_main=$(printf '%s\n' "$remote_refs" | awk -v ref="refs/heads/$main_branch" '$2 == ref {print $1}')
    if [ -z "$remote_main" ] || ! git merge-base --is-ancestor "$remote_main" HEAD; then
        echo "Fetch origin and fast-forward/reconcile $main_branch before releasing; origin is not an ancestor of HEAD." >&2
        return 1
    fi
    # Include local tags to detect an earlier release whose push failed.
    local_tags=$(git tag --list 'v*') || return 1
    latest_tag=0.0.0
    while IFS= read -r remote_tag; do
        remote_tag=${remote_tag#v}
        version:validate "$remote_tag" 2>/dev/null || continue
        if version:is_greater "$remote_tag" "$latest_tag"; then latest_tag=$remote_tag; fi
    done <<< "$(printf '%s\n' "$remote_refs" | awk '$2 ~ /^refs\/tags\/v/ && $2 !~ /\^\{\}$/ {sub(/^refs\/tags\/v/, "", $2); print $2}')
$local_tags"
    if version:is_greater "$latest_tag" "$current_version"; then
        echo "$VERSION_FILE ($current_version) is behind release tag v$latest_tag; reconcile the baseline first." >&2
        return 1
    fi
    # A local-only tag means a previous push may need recovery, not another bump.
    if git show-ref --verify --quiet "refs/tags/v$current_version" &&
       ! printf '%s\n' "$remote_refs" | awk -v ref="refs/tags/v$current_version" '$2 == ref {found=1} END {exit !found}'; then
        echo "Local v$current_version is not on origin. Recover its atomic push before another release." >&2
        return 1
    fi
    tag=$(version:bump "$level") || return 1
    release_tag="v$tag"
    message=${message:-"New $level release: $release_tag"}
    printf 'Release %s → %s: commit .version/CHANGELOG.md, tag, atomic push to origin/%s.\n' "$current_version" "$tag" "$main_branch"
    echo "GitHub will build/sign/notarize a draft, then wait for release-publish approval."
    if [ "$dry_run" -eq 1 ]; then
        echo "Dry run: no files, commits, tags or remote refs changed."
        return 0
    fi

    # Populate history for git-cliff without advancing the branch.
    git fetch origin "$main_branch" --tags || return 1
    git merge-base --is-ancestor "origin/$main_branch" HEAD || return 1
    if git show-ref --verify --quiet "refs/tags/$release_tag"; then
        echo "Release tag already exists: $release_tag" >&2
        return 1
    fi
    head_before=$(git rev-parse HEAD) || return 1
    if release:notes:has_content "$release_notes_file"; then
        release_notes_hash=$(git hash-object -- "$release_notes_file") || return 1
    fi
    changelog_temp=$(mktemp "${TMPDIR:-/tmp}/camstream-changelog.XXXXXX") || return 1
    if ! release:changelog:generate "$release_tag" "$release_notes_file" "$changelog_temp"; then
        rm -f "$changelog_temp"
        return 1
    fi
    if [ "$(git rev-parse HEAD)" != "$head_before" ] || [ -n "$(git status --porcelain)" ]; then
        rm -f "$changelog_temp"
        echo "Source changed during release preparation; review before retrying." >&2
        return 1
    fi
    mv "$changelog_temp" CHANGELOG.md || return 1
    version:set "$tag" || return 1
    git add -- "$VERSION_FILE" CHANGELOG.md || return 1
    git commit -m "Bump version: $release_tag" || return 1
    git tag -a "$release_tag" -m "$message" || return 1
    if ! git push --atomic origin "HEAD:$main_branch" "refs/tags/$release_tag"; then
        echo "Push failed; local release commit/tag retained. Do not bump again." >&2
        echo "Inspect origin, then retry: git push --atomic origin HEAD:$main_branch refs/tags/$release_tag" >&2
        return 1
    fi
    if [ -n "$release_notes_hash" ] && [ -f "$release_notes_file" ]; then
        if [ "$(git hash-object -- "$release_notes_file")" = "$release_notes_hash" ]; then
            rm -f -- "$release_notes_file" || return 1
        else
            echo "Release notes changed during preparation; preserved: $release_notes_file" >&2
        fi
    fi
    echo "Release tag pushed. Open GitHub Actions → Versioned release artifacts → Review deployments → release-publish."

}

##########################################
# Help and auxiliary functions
##########################################

## Show function code
function help:show {
    declare -f "$1"
}

function help {
    echo ""
    echo "$0 <task> [...arguments]"
    echo ""
    echo "Project: ${PROJECT}"
    echo ""
    echo "Tasks:"
    compgen -A function | grep -v '^_' | cat -n
    echo ""

    prog="$0"
    me=$(basename "$prog")

    grep -e '^##[[:space:]]' -e '^##$' "$prog" | sed -e 's/^##//' -e "s/_PROG_/$me/" 2>&1 | less
}

TIMEFORMAT="Task completed in %3lR"
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi
if [ "$#" -eq 0 ]; then
    set -- help
fi
time "$@"
