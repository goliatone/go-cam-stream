--- /dev/null
+++ b/libavdevice/camstream_audio_uid.h
@@ -0,0 +1,17 @@
+/* Camstream proof: exact audio identity; no name/index/default fallback. */
+#import <Foundation/Foundation.h>
+static BOOL camstreamValidUID(NSString *uid) {
+    return uid && [uid length] && [uid lengthOfBytesUsingEncoding:NSUTF8StringEncoding] <= 1024 &&
+        [uid rangeOfCharacterFromSet:[NSCharacterSet controlCharacterSet]].location == NSNotFound;
+}
+static id camstreamSelectAudio(NSArray *devices, NSString *uid) {
+    if (!camstreamValidUID(uid)) return nil;
+    id selected = nil;
+    for (id device in devices) {
+        if ([[device uniqueID] isEqualToString:uid]) {
+            if (selected) return nil;
+            selected = device;
+        }
+    }
+    return [[selected retain] autorelease];
+}
