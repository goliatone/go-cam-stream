--- /dev/null
+++ b/libavdevice/camstream_audio_queue.h
@@ -0,0 +1,31 @@
+/* Camstream: bounded retained FIFO; overflow is fatal, never a silent drop. */
+#include <CoreFoundation/CoreFoundation.h>
+#define CAMSTREAM_AUDIO_QUEUE_CAPACITY 512
+#define CAMSTREAM_AUDIO_QUEUE_BYTES (4 * 1024 * 1024)
+typedef struct CamstreamAudioQueue {
+    CFTypeRef values[CAMSTREAM_AUDIO_QUEUE_CAPACITY];
+    size_t sizes[CAMSTREAM_AUDIO_QUEUE_CAPACITY], bytes;
+    unsigned head, count;
+    int overflow;
+} CamstreamAudioQueue;
+static void camstreamAudioPush(CamstreamAudioQueue *q, CFTypeRef value, size_t size) {
+    if (q->count == CAMSTREAM_AUDIO_QUEUE_CAPACITY || size > CAMSTREAM_AUDIO_QUEUE_BYTES - q->bytes) { q->overflow = 1; return; }
+    q->values[(q->head + q->count) % CAMSTREAM_AUDIO_QUEUE_CAPACITY] = CFRetain(value);
+    q->sizes[(q->head + q->count) % CAMSTREAM_AUDIO_QUEUE_CAPACITY] = size;
+    q->bytes += size;
+    q->count++;
+}
+/* Transfer the retained reference to the caller. */
+static CFTypeRef camstreamAudioPop(CamstreamAudioQueue *q) {
+    if (!q->count) return NULL;
+    CFTypeRef value = q->values[q->head];
+    q->values[q->head] = NULL;
+    q->bytes -= q->sizes[q->head];
+    q->head = (q->head + 1) % CAMSTREAM_AUDIO_QUEUE_CAPACITY;
+    q->count--;
+    return value;
+}
+static void camstreamAudioClear(CamstreamAudioQueue *q) {
+    CFTypeRef value;
+    while ((value = camstreamAudioPop(q))) CFRelease(value);
+}
