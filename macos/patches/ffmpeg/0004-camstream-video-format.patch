+/*
+ * The configured stream format and the native device format are independent.
+ * Prefer the requested mode when available, otherwise keep the session's
+ * native mode. The publisher scales, pads and resamples the video it receives.
  */
+static int configure_camstream_video_device(AVFormatContext *s, AVCaptureDevice *device)
+{
+    AVFContext *ctx = s->priv_data;
+    const double fps = av_q2d(ctx->framerate);
+
+    for (AVCaptureDeviceFormat *format in device.formats) {
+        CMVideoDimensions size = CMVideoFormatDescriptionGetDimensions(format.formatDescription);
+        if (size.width != ctx->width || size.height != ctx->height)
+            continue;
+        for (AVFrameRateRange *range in format.videoSupportedFrameRateRanges) {
+            if (fps < range.minFrameRate || fps > range.maxFrameRate)
+                continue;
+            if (![device lockForConfiguration:NULL]) {
+                av_log(s, AV_LOG_ERROR, "Camstream video mode unavailable\n");
+                return AVERROR(EINVAL);
+            }
+            device.activeFormat = format;
+            CMTime duration = CMTimeMake(ctx->framerate.den, ctx->framerate.num);
+            device.activeVideoMinFrameDuration = duration;
+            device.activeVideoMaxFrameDuration = duration;
+            [device unlockForConfiguration];
+            return 0;
+        }
+    }
+
+    return 0;
+}
+
 static int configure_video_device(AVFormatContext *s, AVCaptureDevice *video_device)
 {
     AVFContext *ctx = (AVFContext*)s->priv_data;
